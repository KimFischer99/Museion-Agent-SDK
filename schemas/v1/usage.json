{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proactive-agent-sdk.invalid/schemas/v1/usage.json",
  "title": "Usage",
  "description": "SPEC §4.1 Usage. Unmeasurable values are null, never zero; pricing_basis records how numbers were obtained.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "provider", "model", "input_tokens", "output_tokens", "tool_calls", "elapsed_ms", "pricing_basis"],
  "properties": {
    "protocol_version": { "$ref": "#/$defs/protocol_version" },
    "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
    "model": { "type": "string", "minLength": 1, "maxLength": 128 },
    "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "cache_read_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "tool_calls": { "type": ["integer", "null"], "minimum": 0 },
    "elapsed_ms": { "type": ["integer", "null"], "minimum": 0 },
    "pricing_basis": { "enum": ["measured", "estimated", "unknown"] }
  },
  "$defs": {
    "protocol_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
  }
}
