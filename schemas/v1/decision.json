{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proactive-agent-sdk.invalid/schemas/v1/decision.json",
  "title": "Decision",
  "description": "SPEC §4.1 / §8.1 Decision with ActionProposal definitions. Unknown fields, oversized bodies and unsupported kinds are rejected. Cross-field rules (silent=>no proposals, propose=>>=1 proposal, notify_self needs evidence_refs+expires_at) are enforced by contracts.validate_decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "decision", "summary", "proposals"],
  "properties": {
    "protocol_version": { "$ref": "#/$defs/protocol_version" },
    "decision": { "enum": ["propose", "silent"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "proposals": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/action_proposal" }
    }
  },
  "$defs": {
    "protocol_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "action_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fact_id", "revision"],
      "properties": {
        "kind": {
          "enum": ["notify_self", "draft", "internal_record", "suggest_watch", "request_external_action"]
        },
        "fact_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "body": { "type": "string", "maxLength": 20000 },
        "arguments": { "type": "object" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
