{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proactive-agent-sdk.invalid/schemas/v1/context_pack.json",
  "title": "ContextPack",
  "description": "SPEC §4.1 / §7.1 ContextPack. Immutable snapshot for one run. All ids and timestamps in documents using this schema are fake examples unless issued by a live system. recent_notifications is the bounded, redacted summary of notifications already sent in the last 24 h (SPEC §21.1 step 6); it exists so a model can compare topics, openings and fact deltas, and it never carries a message body.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "locale", "timezone", "preferences_ref", "sources", "pending_refs", "sent_fact_refs", "memory_refs", "untrusted_content_policy"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "scope"],
      "properties": {
        "goal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scope": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "maxLength": 32 },
    "timezone": { "type": "string", "pattern": "^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$", "minLength": 1, "maxLength": 64 },
    "preferences_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sources": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/source_snapshot" }
    },
    "pending_refs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 }, "maxItems": 256 },
    "sent_fact_refs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 }, "maxItems": 256 },
    "memory_refs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 }, "maxItems": 256 },
    "memory_entries": {
      "description": "Authorized user memory, frozen for this run and treated as data rather than instructions.",
      "type": "array", "maxItems": 32,
      "items": { "$ref": "#/$defs/memory_entry" }
    },
    "untrusted_content_policy": { "enum": ["data_only"] },
    "recent_notifications": {
      "description": "Already-sent notifications from the last 24 h, reduced to non-sensitive fields. Hard-dedup stays with the business key; this summary only lets a model compare topics, openings and fact deltas (SPEC §21.1 step 6).",
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/recent_notification" }
    }
  },
  "$defs": {
    "memory_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["memory_id", "content", "source"],
      "properties": {
        "memory_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "content": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "source": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evidence_refs": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "confidence": { "enum": ["inferred", "user_confirmed", null] },
        "last_confirmed_at": { "type": ["string", "null"], "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "recent_notification": {
      "description": "One already-sent notification reduced to non-sensitive fields. There is deliberately no body field: redaction is structural, not best-effort.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_digest", "channel_kind", "title", "sent_at_ms"],
      "properties": {
        "fact_digest": { "description": "Short digest of the fact id: comparable across messages, but not a ledger key.", "type": "string", "minLength": 1, "maxLength": 32 },
        "channel_kind": { "enum": ["local_inbox", "webhook"] },
        "topic": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sent_at_ms": { "type": "integer" }
      }
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "account_ref", "snapshot_ref", "observed_at", "fresh_until", "sensitivity"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "account_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "snapshot_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "observed_at": { "type": "string", "format": "date-time" },
        "fresh_until": { "type": "string", "format": "date-time" },
        "sensitivity": { "enum": ["public", "private", "sensitive"] }
      }
    }
  }
}
