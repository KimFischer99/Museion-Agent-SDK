# systemd EnvironmentFile; also valid as a trusted shell input. Keep the real file 0600.
PAS_EXECUTOR=model
PAS_MODEL_BASE_URL=https://model.example.org/v1
PAS_MODEL_API_KEY=REPLACE_LOCALLY
PAS_MODEL_NAME=REPLACE_LOCALLY
PAS_PAGE_SOURCES_FILE=/etc/pas-demo/sources.json
# Optional, explicitly authorized profile files. Set policy.conversation_context to true
# when using the conversation file; do not point these at unfiltered directories.
# PAS_NOTE_FILE=/etc/pas-demo/notes.md
# PAS_CONVERSATION_FILE=/etc/pas-demo/conversation.json
# Trusted Hermes owner binding; all four values are required for the input hook.
# PAS_HERMES_PLATFORM=telegram
# PAS_HERMES_USER=owner-id
# PAS_HERMES_CHAT=owner-chat-id
# PAS_HERMES_PROFILE=demo
# Optional webhook: configure all three together. Default delivery is local inbox.
# PAS_NOTIFY_URL=https://hooks.example.org/pas
# PAS_NOTIFY_HOST=hooks.example.org
# PAS_NOTIFY_CHANNEL=push:demo
